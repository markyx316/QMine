# Copy to `.env` in this directory and fill in. Never commit the real file.
# QMine loads this automatically; values are never logged or written to artifacts.

DEEPSEEK_API_KEY=sk-...
ZHIPU_API_KEY=...
QWEN_API_KEY=sk-...
# REQUIRED by configs/live.yaml, which is the DEFAULT config: it pins four
# roles (observer, delivery_auditor, adversary, researcher_log_reading) to
# `moonshotai/kimi-k3`, reachable only through OpenRouter. An unroutable pin
# is a config error and deliberately does NOT degrade — the run stops.
OPENROUTER_API_KEY=sk-or-...

# Optional — better web research for the literature/risk researchers.
# Without either, research falls back to DuckDuckGo, which needs no key.
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=...
